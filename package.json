{
  "name": "loon-pi",
  "version": "0.1.0",
  "description": "A pi package that gives the TUI a theme-aware startup banner: the pi-claude-code-tui look, painted entirely by the active theme.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "tui",
    "startup",
    "banner",
    "theme"
  ],
  "license": "MIT",
  "author": "Joshua Rosales",
  "homepage": "https://github.com/loonbac/loon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loonbac/loon.git"
  },
  "bugs": {
    "url": "https://github.com/loonbac/loon/issues"
  },
  "files": [
    "extensions",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/loon-startup.ts",
      "./extensions/inline-work.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
